# Copy to .env.local for local development, and set the same variables in the
# Vercel project settings for production. Do NOT put real secrets in this file.

# ---------------------------------------------------------------------------
# Backend service URLs (no trailing slash)
# ---------------------------------------------------------------------------
# Local:      http://localhost:5000
# Production: https://<your-atmosphere-service>.onrender.com
NEXT_PUBLIC_ATMOSPHERE_URL=http://localhost:5000

# Local:      http://127.0.0.1:5003
# Production: https://<your-classifier-service>.onrender.com
NEXT_PUBLIC_CLASSIFIER_URL=http://127.0.0.1:5003

# ---------------------------------------------------------------------------
# Pre-existing variables (unchanged by the deployment work) — set your own values
# ---------------------------------------------------------------------------
# Exposed to the browser by the NEXT_PUBLIC_ prefix; see docs/ENVIRONMENT.md.
NEXT_PUBLIC_GEMINI_API_KEY=your_actual_gemini_api_key

# Clerk auth — gates /explore, /lab and /play via client/src/middleware.ts
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_actual_publishable_key
CLERK_SECRET_KEY=your_actual_secret_key